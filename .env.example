# Environment variables for the Clinic Booking System.
# Copy this file to .env and fill in the values.

# Application
APP_ENV=local
LOG_LEVEL=INFO

# Used by docker-compose for the postgres service container
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=change_me

# SQLAlchemy async connection URL.
# Inside Docker Compose use host "db"; locally use "localhost".
# The configuration layer automatically converts postgres:// → postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://clinic_user:change_me@localhost:5432/clinic_db
# or if using a docker postgre service with name db
# DATABASE_URL=postgresql+asyncpg://clinic_user:change_me@db:5432/clinic_db 

# Clinic timezone — IANA name
CLINIC_TIMEZONE=Africa/Nairobi

# Minimum minutes before a slot that a booking is allowed
MIN_BOOKING_LEAD_MINUTES=60
